{
  "manifest_version": 3,
  "name": "MeetingDictation",
  "version": "0.2.0",
  "description": "Practise listening on recorded meetings: type what you hear, line by line, on Loom, YouTube and Teams recordings.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "MeetingDictation: start dictation on this video",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.loom.com/share/*",
        "https://loom.com/share/*",
        "https://www.loom.com/embed/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://*.sharepoint.com/*/_layouts/15/stream.aspx*",
        "https://teams.cloud.microsoft/*",
        "https://teams.microsoft.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.sharepoint.com/*"
      ],
      "js": [
        "dist/frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:4100/extension/connect*",
        "https://meetingdictation.com/extension/connect*"
      ],
      "js": [
        "dist/connect.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open or close dictation on this tab"
    }
  },
  "host_permissions": [
    "http://localhost:4100/*",
    "https://meetingdictation.com/*"
  ]
}
