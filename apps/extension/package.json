{
  "name": "@md/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blur the transcript of a recorded meeting (Loom, Zoom, Teams, Meet, any captioned video) and practise dictation on it, WELE-style.",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "echo \"core tests live in @md/core\"",
    "pack": "tsc --noEmit && node pack.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@md/core": "*",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-select": "^2.2.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
