# Local Postgres: `createdb meetingdictation`. Homebrew's Postgres logs you in as your
# macOS user with no password, so replace <you> with the output of `whoami`.
DATABASE_URL="postgresql://<you>@localhost:5432/meetingdictation?schema=public"
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:4100"
# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials,
# redirect URI http://localhost:4100/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Where uploaded recordings are stored
UPLOAD_DIR="./uploads"
# Email (sign-in codes) through Amazon SES v2, with WELE's SES keys. Leave them empty in development:
# the code is then printed to the server console instead of being sent.
AWS_REGION="ap-southeast-1"
AWS_SES_ACCESS_KEY=""
AWS_SES_SECRET_KEY=""
MAIL_FROM="MeetingDictation <meetingdictation@wele-learn.com>"
# Optional: where replies to no-reply@ go
MAIL_REPLY_TO=""
# Billing through Polar (polar.sh): an organization access token, the two product ids
# (yearly $24 with a 7-day trial, lifetime $39) and the webhook endpoint's secret
# (endpoint URL <AUTH_URL>/api/polar/webhook).
POLAR_ACCESS_TOKEN=""
POLAR_PRODUCT_YEARLY=""
POLAR_PRODUCT_LIFETIME=""
POLAR_WEBHOOK_SECRET=""
